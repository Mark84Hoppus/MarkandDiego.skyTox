<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ImageView
            android:id="@+id/chatBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/chat_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    <View
            android:id="@+id/chatBackgroundDim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/chatBackgroundDim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimary"
                android:elevation="16dp"
                android:theme="@style/AppTheme.AppBarOverlay"
                app:navigationIcon="?attr/homeAsUpIndicator">

            <RelativeLayout
                    android:id="@+id/contactHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                <ltd.evilcorp.atox.ui.AvatarImageView
                        android:id="@+id/avatarImageView"
                        android:layout_height="38dp"
                        android:layout_width="38dp"
                        android:layout_toEndOf="@id/locationLiveIndicator"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeColor="@null" />

                <ImageView
                        android:id="@+id/locationLiveIndicator"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/location_live_active"
                        android:src="@drawable/ic_location_globe"
                        android:visibility="gone"
                        app:tint="#28d864"/>

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/avatarImageView"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">
                    <TextView
                            android:id="@+id/title"
                            style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            tools:text="Subject name here" />

                    <TextView
                            android:id="@+id/subtitle"
                            style="@style/TextAppearance.AppCompat.Widget.ActionBar.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            tools:text="clever subtitle" />
                </LinearLayout>

            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>

        <include
                android:id="@+id/ongoingCall"
                layout="@layout/view_ongoing_call"
                app:layout_constraintTop_toBottomOf="@+id/toolbar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

    </com.google.android.material.appbar.AppBarLayout>

    <ListView android:id="@+id/messages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@drawable/message_divider"
            android:dividerHeight="2dp"
            android:stackFromBottom="true"
            android:transcriptMode="normal"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout"/>

    <ImageButton
            android:id="@+id/scrollToBottom"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/chat_scroll_to_bottom_background"
            android:contentDescription="@string/scroll_to_bottom"
            android:elevation="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_keyboard_arrow_down"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/ocean_on_accent"/>

    <LinearLayout android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/chat_input_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">
        <EditText android:id="@+id/outgoingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/message"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxHeight="256dp"
                android:textColor="@color/ocean_input_text"
                android:textColorHint="@color/ocean_input_hint"
                android:backgroundTint="@color/ocean_accent"
                tools:targetApi="26"/>

        <ImageButton android:id="@+id/send"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="@android:color/transparent"
                android:contentDescription="@string/send"
                android:paddingHorizontal="4dp"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                app:tint="@color/ocean_input_text"/>

        <ImageButton android:id="@+id/attach"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="@android:color/transparent"
                android:contentDescription="@string/attach_file"
                android:paddingHorizontal="4dp"
                android:src="@drawable/ic_attach_file"
                app:tint="@color/ocean_input_text"/>

        <TextView android:id="@+id/voiceGestureHint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/voice_gesture_hint"
                android:textColor="@color/ocean_input_hint"
                android:visibility="gone"/>

        <ImageButton android:id="@+id/voiceLockedCancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@android:string/cancel"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/ocean_input_text"/>

        <ImageButton android:id="@+id/voiceLockedSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/send"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                app:tint="@color/ocean_input_text"/>

        <TextView android:id="@+id/voiceRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="@color/ocean_input_text"
                android:visibility="gone"/>

        <ImageButton android:id="@+id/voiceMessage"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="@android:color/transparent"
                android:contentDescription="@string/voice_message"
                android:paddingHorizontal="4dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/ocean_input_text"/>
    </LinearLayout>

    <View
            android:id="@+id/attachmentDismissLayer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="18dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

    <LinearLayout
            android:id="@+id/attachmentPanel"
            android:layout_width="@dimen/attachment_panel_width"
            android:layout_height="@dimen/attachment_panel_height"
            android:layout_marginBottom="@dimen/attachment_panel_bottom_offset"
            android:background="@drawable/chat_attachment_panel_background"
            android:elevation="22dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
                android:id="@+id/attachmentFileAction"
                android:layout_width="@dimen/attachment_action_size"
                android:layout_height="@dimen/attachment_action_size"
                android:layout_marginEnd="18dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/attachment_panel_file"
                android:focusable="true">

            <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_attachment_file_folder" />
        </FrameLayout>

        <TextView
                android:id="@+id/attachmentCameraAction"
                android:layout_width="@dimen/attachment_action_size"
                android:layout_height="@dimen/attachment_action_size"
                android:background="@drawable/attachment_cam_circle"
                android:clickable="true"
                android:contentDescription="@string/attachment_panel_camera"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="CAM"
                android:textColor="@color/ocean_text_primary"
                android:textSize="15sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
