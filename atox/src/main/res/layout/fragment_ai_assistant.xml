<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground">

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/AppTheme.AppBarOverlay"
            app:layout_constraintTop_toTopOf="parent"
            app:popupTheme="@style/AppTheme.PopupOverlay"/>

    <ProgressBar
            android:id="@+id/downloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar"/>

    <LinearLayout
            android:id="@+id/contextBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/ocean_surface"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/downloadProgress">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/contextText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ocean_text_secondary"
                    android:textSize="12sp"
                    tools:text="Контекст: 1.2k / 32k"/>

            <TextView
                    android:id="@+id/aiThinkingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="@string/ai_thinking_status"
                    android:textColor="@color/ocean_text_primary"
                    android:textSize="12sp"
                    android:visibility="gone"/>
        </LinearLayout>

        <ProgressBar
                android:id="@+id/contextProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="32000"
                android:progress="0"/>
    </LinearLayout>

    <LinearLayout
            android:id="@+id/dialogListPane"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contextBar">

        <Button
                android:id="@+id/newDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:text="@string/ai_new_dialog"/>

        <ListView
                android:id="@+id/dialogList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="?android:attr/listDivider"
                android:paddingBottom="24dp"
                tools:listitem="@android:layout/simple_list_item_1"/>
    </LinearLayout>

    <ScrollView
            android:id="@+id/aiSettingsPane"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contextBar">

        <LinearLayout
                android:id="@+id/aiSettingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"/>
    </ScrollView>

    <LinearLayout
            android:id="@+id/chatPane"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contextBar">

        <ListView
                android:id="@+id/aiMessages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@drawable/message_divider"
                android:stackFromBottom="true"
                android:transcriptMode="normal"/>

        <TextView
                android:id="@+id/aiAttachmentChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/ai_attachment_chip_background"
                android:ellipsize="middle"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/ocean_text_primary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="document.txt"/>

        <LinearLayout
                android:id="@+id/aiBottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/chat_input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <EditText
                    android:id="@+id/aiInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/ocean_accent"
                    android:hint="@string/message"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxHeight="256dp"
                    android:textColor="@color/ocean_input_text"
                    android:textColorHint="@color/ocean_input_hint"
                    tools:targetApi="26"/>

            <ImageButton
                    android:id="@+id/aiAttach"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/attach_file"
                    android:paddingHorizontal="8dp"
                    android:src="@drawable/ic_attach_file"
                    app:tint="@color/ocean_input_text"/>

            <ImageButton
                    android:id="@+id/aiSend"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/send"
                    android:paddingHorizontal="8dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/ocean_input_text"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
            android:id="@+id/webSearchControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:elevation="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contextBar">

        <TextView
                android:id="@+id/webSearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/ai_web_search"
                android:textColor="@color/ocean_text_primary"
                android:textSize="11sp"/>

        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/webSearchSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:padding="0dp"/>
    </LinearLayout>

    <LinearLayout
            android:id="@+id/aiCachePreparingOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/ocean_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

        <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ai_cache_preparing"
                android:textColor="@color/ocean_text_primary"
                android:textSize="18sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
